# ⚙️ Configuration Frontend - Template
# Copier ce fichier en .env et remplir les valeurs

# =====================
# 🌐 API
# =====================

# URL API backend
VITE_API_URL=http://localhost:5000

# =====================
# 🔧 APPLICATION
# =====================

# Mode développement
VITE_ENV=development

# Nom app
VITE_APP_NAME=Mariage Gallery

# Version
VITE_APP_VERSION=1.0.0

# =====================
# 🔐 SÉCURITÉ
# =====================

# Exposer dans frontend (utiliser VITE_PUBLIC_)
VITE_PUBLIC_API_TIMEOUT=30000

# =====================
# 📊 ANALYTICS (optionnel)
# =====================

# Google Analytics
VITE_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Sentry (error tracking)
VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# =====================
# 🔗 URLs EXTERNES
# =====================

# Contact email
VITE_CONTACT_EMAIL=john.marie0.mariage@site.com

# Téléphone
VITE_PHONE=+33 6 12 34 56 78

# =====================
# 🎨 THÈME
# =====================

# Couleur primaire (hex)
VITE_PRIMARY_COLOR=#f43f5e

# Couleur secondaire
VITE_SECONDARY_COLOR=#ec4899

# =====================
# 🚀 PRODUCTION
# =====================

# URL production
VITE_PRODUCTION_URL=https://mariage.com

# =====================
# 💡 DÉVELOPPEMENT
# =====================

# Debug mode
VITE_DEBUG=false
